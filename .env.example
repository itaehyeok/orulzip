POSTGRES_PASSWORD=change_this_password
POSTGRES_USER=orulzip
CONTAINER_PREFIX=orulzip
POSTGRES_DATA_DIR=/mnt/elements10tb/orulzip/postgres
ORULZIP_DOCKER_NETWORK=orulzip-shared
WEB_PORT=3050
DATABASE_URL=postgres://orulzip:change_this_password@orulzip-postgres:5432/orulzip
ANALYTICS_DATABASE_URL=postgres://orulzip_analytics_writer:change_this_analytics_password@orulzip-postgres:5432/orulzip
ORULZIP_DB_INIT=1
ORULZIP_READ_ONLY=0
MOLIT_APT_TRADE_SERVICE_KEY=
REB_APT_IDENTITY_SERVICE_KEY=
REB_APT_IDENTITY_MATCH_ON_MOLIT_SYNC=1
MOLIT_DAILY_REFRESH_REB_IDENTITY=1
MOLIT_DAILY_TARGETS=nationwide
MOLIT_DAILY_LIMIT=6500
MOLIT_DAILY_DELAY_MS=500
NAVER_MAP_NCP_KEY_ID=
NAVER_MAP_NCP_KEY_SECRET=
ORULZIP_ADMIN_USER=
ORULZIP_ADMIN_PASSWORD=
ORULZIP_ADMIN_SESSION_SECRET=
ORULZIP_ADMIN_COOKIE_SECURE=0
ORULZIP_TELEGRAM_BOT_TOKEN=
ORULZIP_TELEGRAM_CHAT_ID=
ORULZIP_TELEGRAM_VISITOR_ALERT_ENVIRONMENTS=production

# Isolated Firebat development stack (docker-compose.development.yml)
DEVELOPMENT_POSTGRES_DB=orulzip_dev
DEVELOPMENT_POSTGRES_OWNER=orulzip_dev_owner
DEVELOPMENT_POSTGRES_PASSWORD=change_this_development_owner_password
DEVELOPMENT_POSTGRES_DATA_DIR=/mnt/elements10tb/orulzip/postgres-development
DEVELOPMENT_DB_READONLY_USER=orulzip_dev_readonly
DEVELOPMENT_DB_READONLY_PASSWORD=change_this_development_readonly_password
DEVELOPMENT_DB_ANALYTICS_USER=orulzip_dev_analytics_writer
DEVELOPMENT_DB_ANALYTICS_PASSWORD=change_this_development_analytics_password
DEVELOPMENT_WEB_BIND_ADDRESS=192.168.0.6
ORULZIP_DEVELOPMENT_DOCKER_NETWORK=orulzip-development-private
ORULZIP_DEVELOPMENT_EDGE_DOCKER_NETWORK=orulzip-development-edge
DEVELOPMENT_ADMIN_USER=
DEVELOPMENT_ADMIN_PASSWORD=
DEVELOPMENT_ADMIN_SESSION_SECRET=change_this_development_session_secret
DEVELOPMENT_ANALYTICS_HASH_SECRET=change_this_development_analytics_hash_secret
DEVELOPMENT_NAVER_MAP_NCP_KEY_ID=
DEVELOPMENT_NAVER_MAP_NCP_KEY_SECRET=
DEVELOPMENT_NAVER_MAP_DISABLED=1
DEVELOPMENT_MOLIT_APT_TRADE_SERVICE_KEY=
DEVELOPMENT_TELEGRAM_BOT_TOKEN=
DEVELOPMENT_TELEGRAM_CHAT_ID=
